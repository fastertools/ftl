{
  "project_switch": {
    "method": "POST",
    "endpoint": "/htmx/project/switch",
    "target": "#main-container",
    "swap": "innerHTML",
    "expectedParams": ["path"]
  },
  "htmxRequests": {
    "projectSwitch": {
      "method": "POST",
      "endpoint": "/htmx/project/switch",
      "target": "#main-container",
      "swap": "innerHTML",
      "expectedParams": ["path"]
    },
    "projectRemove": {
      "method": "DELETE", 
      "endpoint": "/htmx/project/remove",
      "target": "#project-list",
      "swap": "innerHTML",
      "confirmation": "Remove this project?",
      "expectedParams": ["path"]
    },
    "statusPoll": {
      "method": "POST",
      "endpoint": "/htmx/status/poll",
      "trigger": "load, every 1s",
      "swap": "innerHTML",
      "expectedParams": ["project_path"]
    },
    "logsPoll": {
      "method": "POST", 
      "endpoint": "/htmx/logs/poll",
      "trigger": "every 500ms",
      "swap": "beforeend",
      "expectedParams": ["project_path"]
    }
  },
  "controlOperations": {
    "build": {
      "method": "POST",
      "endpoint": "/mcp",
      "target": "#ftl-output", 
      "swap": "beforeend",
      "preRequestMessage": "Sending build command",
      "expectedFormData": {
        "action": "build",
        "project-path": "{project.Path}"
      }
    },
    "up": {
      "method": "POST",
      "endpoint": "/mcp",
      "target": "#ftl-output",
      "swap": "beforeend", 
      "preRequestMessage": "Starting FTL server",
      "expectedFormData": {
        "action": "up",
        "mode": "regular",
        "project-path": "{project.Path}"
      }
    },
    "watch": {
      "method": "POST",
      "endpoint": "/mcp",
      "target": "#ftl-output",
      "swap": "beforeend",
      "preRequestMessage": "Starting FTL in watch mode", 
      "expectedFormData": {
        "action": "up",
        "mode": "watch",
        "project-path": "{project.Path}"
      }
    }
  }
}