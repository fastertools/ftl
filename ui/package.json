{
  "name": "ftl-console",
  "version": "1.0.0",
  "description": "E2E testing for FTL CLI console interface",
  "scripts": {
    "test": "playwright test --config=playwright.config.ts",
    "test:headed": "playwright test --config=playwright.config.ts --headed",
    "test:debug": "playwright test --config=playwright.config.ts --debug",
    "test:report": "playwright show-report",
    "install-playwright": "npx playwright install chromium",
    "setup": "npm install && npx playwright install chromium",
    "css:build": "npx @tailwindcss/cli -c tailwind.config.js -i ../static/css/input.css -o ../static/css/output.css",
    "css:watch": "npx @tailwindcss/cli -c tailwind.config.js -i ../static/css/input.css -o ../static/css/output.css --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/cli": "^4.1.12",
    "@types/node": "^24.3.0",
    "playwright": "^1.40.0",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
