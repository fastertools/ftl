package templates

import (
	"fmt"
	"github.com/fastertools/ftl/internal/mcpclient"
	ui "github.com/fastertools/ftl/ui/gen"
)

script handleToolButtonHover(bgColor string) {
	this.style.backgroundColor = bgColor;
}

script handleToolButtonOut(bgColor string) {
	this.style.backgroundColor = bgColor;
}

// ToolsList displays the list of available tools from running servers
templ ToolsList(project Project, tools []*mcpclient.Tool, hash string) {
	<div data-tools-hash={ hash }>
		<h3 class="text-sm font-medium mb-2" style={ "color: " + ui.Colors.UI["muted_text"] }>Available Tools</h3>
		if len(tools) == 0 {
			<div class="text-sm" style={ "color: " + ui.Colors.UI["secondary_text"] }>No tools available</div>
		} else {
			<div class="space-y-2">
				for i, tool := range tools {
					<div class="p-2 rounded" style={ "background-color: " + ui.Colors.UI["panel_bg"] }>
						<div class="flex items-center justify-between">
							<div class="flex-1">
								<div class="text-sm font-medium" style={ "color: " + ui.Colors.Primary.Text }>{ tool.Name }</div>
								if tool.Description != "" {
									<div class="text-xs mt-1" style={ "color: " + ui.Colors.UI["muted_text"] }>{ tool.Description }</div>
								}
							</div>
							if tool.InputSchema != nil {
								<button 
									hx-get={ fmt.Sprintf("/tool-params/%d", i) }
									hx-target={ fmt.Sprintf("#tool-params-%d", i) }
									hx-swap="innerHTML"
									class="text-xs px-2 py-1 rounded transition-colors"
									style={ fmt.Sprintf("background-color: %s; color: %s;", ui.Colors.UI["button_bg"], ui.Colors.UI["muted_text"]) }
									onmouseover={ handleToolButtonHover(ui.Colors.UI["button_bg_hover"]) }
									onmouseout={ handleToolButtonOut(ui.Colors.UI["button_bg"]) }
								>
									Parameters
								</button>
							}
						</div>
						<div id={ fmt.Sprintf("tool-params-%d", i) } hx-preserve="true"></div>
					</div>
				}
			</div>
		}
	</div>
}

// ToolParams displays the parameters for a specific tool
templ ToolParams(tool *mcpclient.Tool, index int) {
	<div class="mt-2 p-2 rounded" style={ "background-color: " + ui.Colors.UI["tool_param_bg"] }>
		<div class="text-xs font-medium mb-2" style={ "color: " + ui.Colors.UI["muted_text"] }>Parameters:</div>
		if tool.InputSchema != nil {
			<pre class="text-xs overflow-x-auto" style={ "color: " + ui.Colors.UI["tool_label_text"] }>{ fmt.Sprintf("%+v", tool.InputSchema) }</pre>
		} else {
			<div class="text-xs" style={ "color: " + ui.Colors.UI["secondary_text"] }>No parameters</div>
		}
	</div>
}