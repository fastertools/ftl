package templates

import (
	"fmt"
	ui "github.com/fastertools/ftl/ui/gen"
	"github.com/fastertools/ftl/ui/components"
)

script addBuildMessage() {
	document.getElementById('ftl-output').insertAdjacentHTML('beforeend', '<div style="color: #3b82f6">[' + new Date().toTimeString().slice(0,8) + '] Sending build command...</div>');
}

script addUpMessage() {
	document.getElementById('ftl-output').insertAdjacentHTML('beforeend', '<div style="color: #3b82f6">[' + new Date().toTimeString().slice(0,8) + '] Starting FTL server...</div>');
}

script addWatchMessage() {
	document.getElementById('ftl-output').insertAdjacentHTML('beforeend', '<div style="color: #3b82f6">[' + new Date().toTimeString().slice(0,8) + '] Starting FTL in watch mode...</div>');
}



// ControlCenter combines status monitoring and control functionality into a unified panel
templ ControlCenter(project Project, processStatus ProcessStatus, serverStatus ServerStatus, commandHistory []CommandOutput) {
	<div>
		<h2 class={ ui.CSSClasses.Components["heading_lg"] }>{ ui.WebUI.Titles["control_center"] }</h2>
		
		<div class={ ui.CSSClasses.Components["space_y_4"] }>
			<!-- Process Status Section -->
			<div>
				<h3 class={ ui.CSSClasses.Composite["section_heading"] } style={ "color: " + ui.Colors.UI["muted_text"] }>{ ui.WebUI.Sections["process_status"] }</h3>
				<div id="ftl-status" 
					 hx-post="/htmx/status/poll" 
					 hx-trigger="load, every 1s" 
					 hx-swap="innerHTML"
					 hx-vals={ fmt.Sprintf(`{"project_path": "%s"}`, project.Path) }
					 class={ ui.CSSClasses.Components["space_y_2"] }>
					<!-- Process status rows - will be replaced by HTMX -->
					<div class={ ui.CSSClasses.Composite["process_row"] } style={ "background-color: " + ui.Colors.UI["button_bg"] }>
						<div class={ ui.CSSClasses.Components["flex_space_3"] }>
							<span class={ ui.CSSClasses.Components["text_value"] }>{ ui.ProcessNameRegular }</span>
							<div class={ ui.CSSClasses.Components["status_dot"] + " " + ui.CSSClasses.StatusDots["stopped"] }></div>
							<span class={ ui.CSSClasses.Components["text_mono_xs"] } style={ "color: " + ui.Colors.UI["secondary_text"] }>{ ui.StatusStopped }</span>
						</div>
					</div>
					<div class={ ui.CSSClasses.Composite["process_row"] } style={ "background-color: " + ui.Colors.UI["button_bg"] }>
						<div class={ ui.CSSClasses.Components["flex_space_3"] }>
							<span class={ ui.CSSClasses.Components["text_value"] }>{ ui.ProcessNameWatch }</span>
							<div class={ ui.CSSClasses.Components["status_dot"] + " " + ui.CSSClasses.StatusDots["stopped"] }></div>
							<span class={ ui.CSSClasses.Components["text_mono_xs"] } style={ "color: " + ui.Colors.UI["secondary_text"] }>{ ui.StatusInactive }</span>
						</div>
					</div>
				</div>
			</div>
			
			<!-- Control Buttons Section -->
			<div class={ ui.CSSClasses.Components["border_top"] } style={ "border-color: " + ui.Colors.UI["border_primary"] }>
				<h3 class={ ui.CSSClasses.Composite["section_heading"] } style={ "color: " + ui.Colors.UI["muted_text"] }>{ ui.WebUI.Sections["operations"] }</h3>
				<div class={ ui.CSSClasses.Components["control_panel"] } style={ fmt.Sprintf("background-color: %s; border: 1px solid %s;", ui.Colors.UI["panel_bg"], ui.Colors.UI["border_primary"]) }>
					<div class={ ui.CSSClasses.Components["grid_3_cols"] }>
						<!-- Build Button -->
						<form hx-post="/mcp" 
							hx-target="#ftl-output"
							hx-swap="beforeend"
							hx-on::before-request={ addBuildMessage() }>
							<input type="hidden" name="action" value="build"/>
							<input type="hidden" name="project-path" value={ project.Path }/>
							@components.BaseButton(components.BaseButtonConfig{
								Type: "submit",
								Content: "Build",
							})
						</form>
						
						<!-- Up (Regular Mode) Button -->
						<form hx-post="/mcp" 
							hx-target="#ftl-output"
							hx-swap="beforeend"
							hx-on::before-request={ addUpMessage() }>
							<input type="hidden" name="action" value="up"/>
							<input type="hidden" name="project-path" value={ project.Path }/>
							<input type="hidden" name="mode" value="regular"/>
							@components.BaseButton(components.BaseButtonConfig{
								Type: "submit",
								Content: "Up",
							})
						</form>
						
						<!-- Up (Watch Mode) Button -->
						<form hx-post="/mcp" 
							hx-target="#ftl-output"
							hx-swap="beforeend"
							hx-on::before-request={ addWatchMessage() }>
							<input type="hidden" name="action" value="up"/>
							<input type="hidden" name="project-path" value={ project.Path }/>
							<input type="hidden" name="mode" value="watch"/>
							@components.BaseButton(components.BaseButtonConfig{
								Type: "submit",
								Content: "Watch",
							})
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
}

