package templates

import (
	"fmt"
	ui "github.com/fastertools/ftl/ui/gen"
)



// ControlPanel provides FTL control buttons and forms with HTMX integration
templ ControlPanel(project Project) {
	<div>
		<h2 class="text-lg font-semibold mb-4 text-white">{ ui.WebUI.Titles["control_panel"] }</h2>
		
		<div class="space-y-4">
			<!-- Simplified FTL Operations -->
			<div class="p-4 rounded-lg" style={ fmt.Sprintf("background-color: %s;", ui.Colors.UI["panel_bg"]) }>
				<div class="grid grid-cols-4 gap-3">
					<!-- Build Button -->
					<form hx-post="/mcp" hx-target="#ftl-output">
						<input type="hidden" name="action" value="build"/>
						<input type="hidden" name="project-path" value={ project.Path }/>
						<button 
							type="submit"
							class="w-full text-white text-sm py-2 px-4 rounded-md transition-all duration-200 font-medium"
					onmouseover="this.style.backgroundColor='#6a6a6a'; this.style.borderColor='#8a8a8a'; this.style.transform='translateY(-1px)';"
					onmouseout="this.style.backgroundColor='#4a4a4a'; this.style.borderColor='#5a5a5a'; this.style.transform='translateY(0)';"
							style={ fmt.Sprintf("background-color: %s; border: 1px solid %s;", ui.Colors.UI["button_bg"], ui.Colors.UI["button_border"]) }
						>
							Build
						</button>
					</form>
					
					<!-- Up Button -->
					<form hx-post="/mcp" hx-target="#ftl-output">
						<input type="hidden" name="regular-project-path" value={ project.Path }/>
						<button 
							type="submit"
							class="w-full text-white text-sm py-2 px-4 rounded-md transition-all duration-200 font-medium"
					onmouseover="this.style.backgroundColor='#6a6a6a'; this.style.borderColor='#8a8a8a'; this.style.transform='translateY(-1px)';"
					onmouseout="this.style.backgroundColor='#4a4a4a'; this.style.borderColor='#5a5a5a'; this.style.transform='translateY(0)';"
							style={ fmt.Sprintf("background-color: %s; border: 1px solid %s;", ui.Colors.UI["button_bg"], ui.Colors.UI["button_border"]) }
						>
							Up
						</button>
					</form>
					
					<!-- Watch Button -->
					<form hx-post="/mcp" hx-target="#ftl-output">
						<input type="hidden" name="watch-project-path" value={ project.Path }/>
						<button 
							type="submit"
							class="w-full text-white text-sm py-2 px-4 rounded-md transition-all duration-200 font-medium"
					onmouseover="this.style.backgroundColor='#6a6a6a'; this.style.borderColor='#8a8a8a'; this.style.transform='translateY(-1px)';"
					onmouseout="this.style.backgroundColor='#4a4a4a'; this.style.borderColor='#5a5a5a'; this.style.transform='translateY(0)';"
							style={ fmt.Sprintf("background-color: %s; border: 1px solid %s;", ui.Colors.UI["button_bg"], ui.Colors.UI["button_border"]) }
						>
							Watch
						</button>
					</form>
					
					<!-- Stop Button -->
					<button 
						hx-post="/mcp"
						hx-target="#ftl-output"
						hx-vals='{"stop": "true"}'
						hx-include="[name='project-path']"
						class="w-full text-white text-sm py-2 px-4 rounded-md transition-all duration-200 font-medium"
					onmouseover="this.style.backgroundColor='#6a6a6a'; this.style.borderColor='#8a8a8a'; this.style.transform='translateY(-1px)';"
					onmouseout="this.style.backgroundColor='#4a4a4a'; this.style.borderColor='#5a5a5a'; this.style.transform='translateY(0)';"
						style={ fmt.Sprintf("background-color: %s; border: 1px solid %s;", ui.Colors.UI["button_bg"], ui.Colors.UI["button_border"]) }
							>
						Stop
					</button>
				</div>
			</div>
			
			<!-- Command Output -->
			<div class="border-t pt-4" style={ fmt.Sprintf("border-color: %s;", ui.Colors.UI["border_primary"]) }>
				<h3 class="text-sm font-medium mb-2" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }>{ ui.WebUI.Sections["command_output"] }</h3>
				<div 
					id="ftl-output" 
					class={ ui.CSSClasses.Text["success"] + " bg-black rounded-lg p-3 font-mono text-xs overflow-hidden" }
					style="min-height: 100px; max-height: 150px; overflow-y: auto;"
				>
					{ ui.WebUI.Messages["ready_commands"] }
				</div>
			</div>
		</div>
	</div>
}