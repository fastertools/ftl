package templates

import (
	"fmt"
	ui "github.com/fastertools/ftl/ui/gen"
)

// BaseStyles generates the base CSS styles for the application
templ BaseStyles() {
	<style type="text/css">
		{ templ.Raw(getBaseCSS()) }
	</style>
}

// getBaseCSS returns the base CSS as a string
func getBaseCSS() string {
	return fmt.Sprintf(`
		body {
			background: %s;
			color: %s;
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
		}
		
		.panel {
			background: %s;
			border: 1px solid %s;
			border-radius: 8px;
		}
		
		.sidebar {
			background: %s;
			border-right: 1px solid %s;
		}
		
		.status-dot {
			width: 8px;
			height: 8px;
			border-radius: 50%%;
			display: inline-block;
			margin-right: 8px;
		}
		
		.status-running { background-color: %s; }
		.status-stopped { background-color: %s; }
		.status-warning { background-color: %s; }
	`,
		ui.Colors.Primary.BG,           // body background
		ui.Colors.Primary.Text,         // body text
		ui.Colors.UI["panel_bg"],       // panel background
		ui.Colors.UI["border_primary"], // panel border
		ui.Colors.UI["sidebar_bg"],     // sidebar background
		ui.Colors.UI["border_primary"], // sidebar border
		ui.Colors.Status["running"],    // status running
		ui.Colors.Status["error"],      // status stopped (error)
		ui.Colors.Status["warning"],    // status warning
	)
}

// DynamicPanelStyle generates inline styles for panel elements
func DynamicPanelStyle() templ.Attributes {
	return templ.Attributes{
		"style": fmt.Sprintf("background-color: %s; border: 1px solid %s; border-radius: 8px;", 
			ui.Colors.UI["panel_bg"], 
			ui.Colors.UI["border_primary"]),
	}
}

// DynamicHeaderStyle generates inline styles for header elements
func DynamicHeaderStyle() templ.Attributes {
	return templ.Attributes{
		"style": fmt.Sprintf("border-color: %s; background-color: %s;", 
			ui.Colors.UI["border_primary"], 
			ui.Colors.UI["header_bg"]),
	}
}

// DynamicTextStyle generates inline styles for text elements
func DynamicTextStyle(colorKey string) templ.Attributes {
	color := ui.Colors.UI[colorKey]
	if color == "" {
		color = ui.Colors.Primary.Text // fallback
	}
	
	return templ.Attributes{
		"style": fmt.Sprintf("color: %s;", color),
	}
}

// DynamicButtonStyle generates inline styles for button elements
func DynamicButtonStyle(bgColor, borderColor, textColor string) templ.Attributes {
	return templ.Attributes{
		"style": fmt.Sprintf("background-color: %s; border-color: %s; color: %s;", 
			bgColor, borderColor, textColor),
	}
}