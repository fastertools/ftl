package templates

import (
    "fmt"
    ui "github.com/fastertools/ftl/ui/gen"
)

// BaseButtonConfig defines the configuration for base buttons with unified hover behavior
// and HTMX integration. This is the foundation component for all buttons in the UI.
//
// Usage patterns:
//   - Control center buttons (Build, Up, Watch)
//   - Form submission buttons  
//   - Action buttons with HTMX integration
//
// Features:
//   - Unified hover behavior (translateY transform + color changes)
//   - Consistent styling via Cue-generated CSS classes and colors
//   - Full HTMX integration support
//   - Disabled state handling
//   - Extensible via ExtraClasses
type BaseButtonConfig struct {
    Type        string  // HTML button type: "submit", "button" 
    Content     string  // Button text/content to display
    HTMX        *HTMXConfig  // Optional HTMX configuration for dynamic behavior
    Disabled    bool         // Whether button should be disabled
    ExtraClasses string     // Additional CSS classes to apply
}

// HTMXConfig provides comprehensive HTMX integration for BaseButton
// Supports all common HTMX patterns used in the FTL Console interface
type HTMXConfig struct {
    Post        string              // hx-post URL for form submissions
    Target      string              // hx-target selector for response content
    Swap        string              // hx-swap method (innerHTML, beforeend, etc.)
    Trigger     string              // hx-trigger events (click, change, etc.)
    Vals        string              // hx-vals for additional form data
    OnRequest   templ.ComponentScript // hx-on::before-request JavaScript handler
}

// Unified hover handlers for all buttons - provides consistent interaction behavior
// These scripts are automatically generated by templ and handle the hover states
// for all BaseButton instances consistently across the application.
script handleUnifiedHover(event templ.JSExpression, bgColor, borderColor string) {
    event.target.style.backgroundColor = bgColor;
    event.target.style.borderColor = borderColor;
    event.target.style.transform = 'translateY(-1px)'; // Subtle lift effect on hover
}

script handleUnifiedOut(event templ.JSExpression, bgColor, borderColor string) {
    event.target.style.backgroundColor = bgColor;
    event.target.style.borderColor = borderColor;
    event.target.style.transform = 'translateY(0)';    // Return to normal position
}

templ BaseButton(config BaseButtonConfig) {
    <button 
        type={config.Type}
        class={ui.CSSClasses.Buttons["ftl_control"] + " " + config.ExtraClasses}
        onmouseover={handleUnifiedHover(templ.JSExpression("event"), ui.Colors.UI["button_bg_hover"], ui.Colors.UI["border_hover"])}
        onmouseout={handleUnifiedOut(templ.JSExpression("event"), ui.Colors.UI["button_bg"], ui.Colors.UI["button_border"])}
        style={fmt.Sprintf("background-color: %s; border: 1px solid %s;", ui.Colors.UI["button_bg"], ui.Colors.UI["button_border"])}
        if config.HTMX != nil {
            if config.HTMX.Post != "" {
                hx-post={config.HTMX.Post}
            }
            if config.HTMX.Target != "" {
                hx-target={config.HTMX.Target}
            }
            if config.HTMX.Swap != "" {
                hx-swap={config.HTMX.Swap}
            }
            if config.HTMX.Trigger != "" {
                hx-trigger={config.HTMX.Trigger}
            }
            if config.HTMX.Vals != "" {
                hx-vals={config.HTMX.Vals}
            }
            if config.HTMX.OnRequest.Name != "" {
                hx-on::before-request={config.HTMX.OnRequest}
            }
        }
        if config.Disabled {
            disabled
        }>
        {config.Content}
    </button>
}

