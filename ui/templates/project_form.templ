package templates

import (
	"fmt"
	ui "github.com/fastertools/ftl/ui/gen"
)

script handleProjectHover(bgColor string) {
	this.style.backgroundColor = bgColor;
	this.style.transform = 'translateY(-1px)';
}

script handleProjectOut(bgColor string) {
	this.style.backgroundColor = bgColor;
	this.style.transform = 'translateY(0)';
}


// AddProjectForm renders the inline form for adding a new project
templ AddProjectForm() {
	<div id="add-project-container" class="mt-2">
		<form 
			hx-post="/htmx/project/add"
			hx-target="#project-list"
			hx-swap="innerHTML"
			class="space-y-2 p-3 bg-gray-800 rounded-md"
		>
			<div>
				<input 
					type="text" 
					name="name" 
					placeholder="Project name"
					required
					class="w-full px-2 py-1 text-sm bg-gray-900 text-white rounded border border-gray-700 focus:border-blue-500 focus:outline-none"
				/>
			</div>
			<div>
				<input 
					type="text" 
					name="path" 
					placeholder="/path/to/project"
					required
					class="w-full px-2 py-1 text-sm bg-gray-900 text-white rounded border border-gray-700 focus:border-blue-500 focus:outline-none"
				/>
			</div>
			<div class="flex space-x-2">
				<button 
					type="submit"
					class={ fmt.Sprintf("flex-1 px-2 py-1 text-sm rounded transition-colors %s", ui.CSSClasses.Buttons["primary"]) }
				>
					Add
				</button>
				<button 
					type="button"
					hx-get="/htmx/project/cancel-form"
					hx-target="#add-project-container"
					hx-swap="outerHTML"
					class={ fmt.Sprintf("flex-1 px-2 py-1 text-sm rounded transition-colors %s", ui.CSSClasses.Buttons["secondary"]) }
				>
					Cancel
				</button>
			</div>
		</form>
	</div>
}

// AddProjectButton renders the default add project button
templ AddProjectButton() {
	<div id="add-project-container">
		<button 
			id="add-project-btn"
			hx-get="/htmx/project/add-form"
			hx-target="#add-project-container"
			hx-swap="outerHTML"
			class="w-full text-left px-3 py-2 text-sm rounded-md hover:bg-gray-800 hover:shadow-md transition-all duration-200 group"
		>
			<div class="flex items-center group-hover:text-white transition-colors duration-200" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }>
				<span class="w-2 h-2 border border-gray-500 group-hover:border-white rounded-full mr-2 transition-colors duration-200"></span>
				<span>+ Add Project</span>
			</div>
		</button>
	</div>
}

// ProjectList renders the updated project list after add/remove operations
templ ProjectList(projects []Project, currentProjectPath string) {
	<div id="project-list" class="space-y-1">
		<!-- Render existing projects -->
		for _, project := range projects {
			if project.Path == currentProjectPath {
				<div class="project-item project-item-active px-3 py-2 text-sm rounded-md" data-project-name={ project.Name } data-project-path={ project.Path } style={ fmt.Sprintf("background-color: %s; border-left: 5px solid %s;", ui.Colors.UI["button_bg_hover"], ui.Colors.Accents["blue"]) }>
					<div class="flex items-center justify-between">
						<div class="flex items-center">
							// Determine process type for unified status
							if project.WatchRunning {
								@UniversalStatusDot(true, "watch", "sm", false)
							} else if project.FTLRunning {
								@UniversalStatusDot(true, "regular", "sm", false)
							} else {
								@UniversalStatusDot(false, "", "sm", false)
							}
							<span class="project-name ml-2" style={ fmt.Sprintf("color: %s;", ui.Colors.Primary.Text) }>{ project.Name }</span>
						</div>
						<button 
							hx-delete={ "/htmx/project/remove?path=" + project.Path }
							hx-target="#project-list"
							hx-swap="innerHTML"
							hx-confirm="Remove this project?"
							class="text-red-400 hover:text-red-300 text-xs"
							aria-label={ "Remove project " + project.Name }
						>
							×
						</button>
					</div>
				</div>
			} else {
				<div 
					class="project-item project-item-inactive px-3 py-2 text-sm rounded-md transition-all duration-200 cursor-pointer" 
					data-project-name={ project.Name } 
					data-project-path={ project.Path }
					style={ fmt.Sprintf("background-color: %s;", ui.Colors.UI["button_bg"]) }
					onmouseover={ handleProjectHover(ui.Colors.UI["button_bg_hover"]) }
					onmouseout={ handleProjectOut(ui.Colors.UI["button_bg"]) }>
					<div class="flex items-center justify-between">
						<button 
							hx-post={ "/htmx/project/switch?path=" + project.Path }
							hx-target="#main-container"
							hx-swap="innerHTML"
							class="flex-1 text-left flex items-center cursor-pointer"
							aria-label={ "Switch to project " + project.Name }
						>
							// Determine process type for unified status
							if project.WatchRunning {
								@UniversalStatusDot(true, "watch", "sm", false)
							} else if project.FTLRunning {
								@UniversalStatusDot(true, "regular", "sm", false)
							} else {
								@UniversalStatusDot(false, "", "sm", false)
							}
							<span class="project-name ml-2" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }>{ project.Name }</span>
						</button>
						<button 
							hx-delete={ "/htmx/project/remove?path=" + project.Path }
							hx-target="#project-list"
							hx-swap="innerHTML"
							hx-confirm="Remove this project?"
							class="text-red-400 hover:text-red-300 text-xs ml-2"
							aria-label={ "Remove project " + project.Name }
						>
							×
						</button>
					</div>
				</div>
			}
		}
		
		<!-- Add Project Button/Form -->
		@AddProjectButton()
	</div>
}

// ProjectListContents renders just the contents for HTMX updates
templ ProjectListContents(projects []Project, currentProjectPath string) {
	<!-- Render existing projects -->
	for _, project := range projects {
		if project.Path == currentProjectPath {
			<div class="project-item project-item-active px-3 py-2 text-sm rounded-md" data-project-name={ project.Name } data-project-path={ project.Path } style={ fmt.Sprintf("background-color: %s;", ui.Colors.UI["panel_bg"]) }>
				<div class="flex items-center justify-between">
					<div class="flex items-center">
						// Determine process type for unified status
						if project.WatchRunning {
							@UniversalStatusDot(true, "watch", "sm", false)
						} else if project.FTLRunning {
							@UniversalStatusDot(true, "regular", "sm", false)
						} else {
							@UniversalStatusDot(false, "", "sm", false)
						}
						<span class="project-name ml-2" style={ fmt.Sprintf("color: %s;", ui.Colors.Primary.Text) }>{ project.Name }</span>
					</div>
					<button 
						hx-delete={ "/htmx/project/remove?path=" + project.Path }
						hx-target="#project-list"
						hx-swap="innerHTML"
						hx-confirm="Remove this project?"
						class="text-red-400 hover:text-red-300 text-xs"
						aria-label={ "Remove project " + project.Name }
					>
						×
					</button>
				</div>
			</div>
		} else {
			<div 
				class="project-item project-item-inactive px-3 py-2 text-sm rounded-md transition-all duration-200 cursor-pointer" 
				data-project-name={ project.Name } 
				data-project-path={ project.Path }>
				<div class="flex items-center justify-between">
					<button 
						hx-post={ "/htmx/project/switch?path=" + project.Path }
						hx-target="#main-container"
						hx-swap="innerHTML"
						class="flex-1 text-left flex items-center"
						aria-label={ "Switch to project " + project.Name }
					>
						// Determine process type for unified status
						if project.WatchRunning {
							@UniversalStatusDot(true, "watch", "sm", false)
						} else if project.FTLRunning {
							@UniversalStatusDot(true, "regular", "sm", false)
						} else {
							@UniversalStatusDot(false, "", "sm", false)
						}
						<span class="project-name ml-2" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }>{ project.Name }</span>
					</button>
					<button 
						hx-delete={ "/htmx/project/remove?path=" + project.Path }
						hx-target="#project-list"
						hx-swap="innerHTML"
						hx-confirm="Remove this project?"
						class="text-red-400 hover:text-red-300 text-xs ml-2"
						aria-label={ "Remove project " + project.Name }
					>
						×
					</button>
				</div>
			</div>
		}
	}
	
	<!-- Add Project Button/Form -->
	@AddProjectButton()
}