package templates

import (
	"fmt"
	ui "github.com/fastertools/ftl/ui/gen"
)

script switchTab(tab, mutedColor string) {
	// Hide all content
	document.getElementById('logs-content').style.display = 'none';
	document.getElementById('commands-content').style.display = 'none';
	
	// Reset all tab styles
	document.getElementById('logs-tab').className = 'px-4 py-2 text-sm font-medium border-b-2 border-transparent';
	document.getElementById('logs-tab').style.color = mutedColor;
	document.getElementById('commands-tab').className = 'px-4 py-2 text-sm font-medium border-b-2 border-transparent';
	document.getElementById('commands-tab').style.color = mutedColor;
	
	// Show selected content and update tab style
	if (tab === 'logs') {
		document.getElementById('logs-content').style.display = 'block';
		document.getElementById('logs-tab').className = 'px-4 py-2 text-sm font-medium border-b-2 text-white';
		document.getElementById('logs-tab').style.borderColor = '#60a5fa';
		document.getElementById('logs-tab').style.color = '';
	} else if (tab === 'commands') {
		document.getElementById('commands-content').style.display = 'block';
		document.getElementById('commands-tab').className = 'px-4 py-2 text-sm font-medium border-b-2 text-white';
		document.getElementById('commands-tab').style.borderColor = '#60a5fa';
		document.getElementById('commands-tab').style.color = '';
	}
}

script setupHTMXListener(mutedColor string) {
	// Listen for HTMX events to auto-switch to command tab when commands are executed
	document.body.addEventListener('htmx:afterRequest', function(evt) {
		if (evt.detail.target && evt.detail.target.id === 'ftl-output') {
			// Call the templ script function with the muted color
			switchTab('commands', mutedColor);
		}
	});
}

// ActivityPanel displays recent activity and logs with live polling in a tabbed interface
templ ActivityPanel(project Project, recentLogs []LogEntry, commandHistory []CommandOutput) {
	<div>
		<div class="flex items-center justify-between mb-4">
			<h2 class="text-lg font-semibold text-white">{ ui.WebUI.Titles["activity"] }</h2>
		</div>
		
		<!-- Tab Navigation -->
		<div class="flex border-b" style={ "border-color: " + ui.Colors.UI["border_primary"] }>
			<button 
				id="logs-tab"
				class="px-4 py-2 text-sm font-medium border-b-2"
				style={ fmt.Sprintf("border-color: %s; color: %s;", ui.Colors.Accents["blue"], ui.Colors.Primary.Text) }
				onclick={ switchTab("logs", ui.Colors.UI["muted_text"]) }
			>
				{ ui.WebUI.Tabs["live_logs"] }
			</button>
			<button 
				id="commands-tab"
				class="px-4 py-2 text-sm font-medium border-b-2 border-transparent"
				style={ "color: " + ui.Colors.UI["muted_text"] }
				onclick={ switchTab("commands", ui.Colors.UI["muted_text"]) }
			>
				{ ui.WebUI.Tabs["command_output"] }
			</button>
		</div>
		
		<!-- Tab Content -->
		<div id="tab-content" class="mt-4">
			<!-- Live Logs Tab (default) -->
			<div id="logs-content">
				<div 
					id="live-log-content" 
					class="bg-black rounded-lg p-3 font-mono text-xs overflow-hidden"
					style="min-height: 200px; max-height: 350px; overflow-y: auto;"
					hx-post="/htmx/logs/poll"
					hx-trigger="every 2s"
					hx-include="[name='project_path']"
					hx-target="this"
					hx-swap="beforeend"
				>
					if len(recentLogs) > 0 {
						for _, logEntry := range recentLogs {
							<div class={ ui.CSSClasses.Text["success"] }>{ logEntry.Message }</div>
						}
					} else {
						<div class={ ui.CSSClasses.Text["success"] }>{ ui.WebUI.Messages["waiting_logs"] }</div>
					}
				</div>
				<!-- Hidden input for project path -->
				<input type="hidden" name="project_path" value={ project.Path }/>
				
				<!-- Log Controls -->
				<div class="mt-3 flex items-center justify-between">
					<div class="flex items-center space-x-2">
						<button 
							onclick="document.getElementById('live-log-content').innerHTML = ''" 
							class="text-xs px-2 py-1 rounded transition-colors"
							style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }
							onmouseover="this.style.backgroundColor='#5a5a5a'"
							onmouseout="this.style.backgroundColor=''" 
							style={ "color: " + ui.Colors.UI["muted_text"] }
						>
							{ ui.WebUI.Buttons["clear"] }
						</button>
						<button 
							onclick="document.getElementById('live-log-content').scrollTop = document.getElementById('live-log-content').scrollHeight" 
							class="text-xs px-2 py-1 rounded transition-colors"
							style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }
							onmouseover="this.style.backgroundColor='#5a5a5a'"
							onmouseout="this.style.backgroundColor=''" 
							style={ "color: " + ui.Colors.UI["muted_text"] }
						>
							Scroll to Bottom
						</button>
					</div>
				</div>
			</div>
			
			<!-- Command Output Tab (hidden by default) -->
			<div id="commands-content" style="display: none;">
				<div 
					id="ftl-output"
					class="bg-black rounded-lg p-3 font-mono text-xs overflow-hidden"
					style="min-height: 200px; max-height: 350px; overflow-y: auto;"
				>
					if len(commandHistory) > 0 {
						for _, cmd := range commandHistory {
							<div class="mb-2">
								<div class={ ui.CSSClasses.Text["warning"] }>&gt; { cmd.Command }</div>
								<div class={ ui.CSSClasses.Text["success"] + " whitespace-pre-wrap" }>{ cmd.Output }</div>
							</div>
						}
					} else {
						<div class={ ui.CSSClasses.Text["success"] }>{ ui.WebUI.Messages["ready_commands"] }</div>
					}
				</div>
			</div>
		</div>
		
		<!-- Setup HTMX event listener -->
		@setupHTMXListener(ui.Colors.UI["muted_text"])
	</div>
}

