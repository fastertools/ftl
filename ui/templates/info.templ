package templates

import (
	"fmt"
	ui "github.com/fastertools/ftl/ui/gen"
)

// InfoPanel displays project information and server details
templ InfoPanel(project Project, serverStatus ServerStatus) {
	<div>
		<h2 class={ ui.CSSClasses.Components["heading_lg"] }>Project Info</h2>
		
		<div class={ ui.CSSClasses.Components["space_y_4"] }>
			<!-- Project Details -->
			<div>
				<h3 class={ ui.CSSClasses.Components["heading_sm"] } style={ "color: " + ui.Colors.UI["muted_text"] }>Project Details</h3>
				<div class={ ui.CSSClasses.Components["space_y_2"] }>
					<div class={ ui.CSSClasses.Components["flex_between"] }>
						<span class={ ui.CSSClasses.Components["text_label"] } style={ "color: " + ui.Colors.UI["muted_text"] }>Name</span>
						<span class={ ui.CSSClasses.Components["text_value"] }>{ project.Name }</span>
					</div>
					<div class={ ui.CSSClasses.Components["flex_between"] }>
						<span class={ ui.CSSClasses.Components["text_label"] } style={ "color: " + ui.Colors.UI["muted_text"] }>Path</span>
						<span class={ ui.CSSClasses.Components["text_mono_xs"] }>{ project.Path }</span>
					</div>
					<div id="port-display" class={ ui.CSSClasses.Components["flex_between"] }>
						if serverStatus.Running && serverStatus.Port > 0 {
							<span class={ ui.CSSClasses.Components["text_label"] } style={ "color: " + ui.Colors.UI["muted_text"] }>Port</span>
							<span class={ ui.CSSClasses.Components["text_mono"] }>{ fmt.Sprintf("%d", serverStatus.Port) }</span>
						}
					</div>
				</div>
			</div>
			
			<!-- Tools Section -->
			<div class={ ui.CSSClasses.Components["border_top"] } style={ "border-color: " + ui.Colors.UI["border_primary"] }>
				<div id="tools-section"
					 hx-get="/tools-list"
					 hx-trigger="load, every 3s"
					 hx-swap="innerHTML"
					 hx-vals='js:{tools_hash: document.querySelector("#tools-section [data-tools-hash]")?.dataset.toolsHash || ""}'>
					<h3 class={ ui.CSSClasses.Components["heading_sm"] } style={ "color: " + ui.Colors.UI["muted_text"] }>Available Tools</h3>
					<div class={ ui.CSSClasses.Components["text_label"] } style={ "color: " + ui.Colors.UI["secondary_text"] }>Loading tools...</div>
				</div>
			</div>
		</div>
	</div>
}

