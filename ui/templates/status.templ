package templates

import (
	"fmt"
	ui "github.com/fastertools/ftl/ui/gen"
	"github.com/fastertools/ftl/internal/models"
)

// StatusPanel displays real-time process status and monitoring
templ StatusPanel(project Project, processStatus ProcessStatus, serverStatus ServerStatus) {
	<div>
		<h2 class="text-lg font-semibold mb-4 text-white">{ ui.WebUI.Titles["status_monitor"] }</h2>
		
		<div class="space-y-4">
			<!-- Process Status -->
			<div>
				<div id="ftl-status" 
					 hx-post="/htmx/status/poll" 
					 hx-trigger="load, every 1s" 
					 hx-swap="innerHTML"
					 hx-vals={ fmt.Sprintf(`{"project_path": "%s"}`, project.Path) }
					 class="space-y-3">
					<!-- Initial loading state - will be replaced by HTMX -->
					<div class="text-center py-4" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }>
						<div class="animate-pulse">Loading process status...</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// Process status display for polling updates - shows single unified status
templ ProcessStatusDisplay(status models.DetailedStatusInfo, projectPath string) {
	<div id="process-status-container" class="space-y-2">
		// Use universal status component
		<div class={ ui.CSSClasses.Composite["process_row"] } 
		     style={ fmt.Sprintf("background-color: %s;", ui.Colors.UI["button_bg"]) }>
			<div class={ ui.CSSClasses.Components["flex_space_3"] }>
				if status.ActiveProcess != nil && status.ActiveProcess.IsRunning {
					@UniversalStatusDot(true, status.ActiveProcess.Type, "md", true)
					@StopButton(status.ActiveProcess.Type, projectPath, true)
				} else {
					@UniversalStatusDot(false, "", "md", true)
				}
			</div>
		</div>
	</div>
	
	// Show port if regular FTL is running
	if status.ActiveProcess != nil && status.ActiveProcess.IsRunning && 
	   status.ActiveProcess.Type == "regular" && status.ActiveProcess.Port > 0 {
		@PortDisplayOOB(status.ActiveProcess.Port)
	}
}


// Port display with OOB swap capability
templ PortDisplayOOB(port int) {
	<div hx-swap-oob="innerHTML:#port-display">
		<span class="text-sm" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }>
			Port
		</span>
		<span class="text-sm text-white font-mono">{ fmt.Sprintf("%d", port) }</span>
	</div>
}

// Port display regular (non-OOB)
templ PortDisplay(port int) {
	<div id="port-display">
		<span class="text-sm" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }>
			Port
		</span>
		<span class="text-sm text-white font-mono">{ fmt.Sprintf("%d", port) }</span>
	</div>
}

// Stop button component
templ StopButton(processType, projectPath string, isRunning bool) {
	if isRunning {
		<button 
			hx-post="/htmx/process/stop"
			hx-vals={ fmt.Sprintf(`{"processType":"%s","project_path":"%s"}`, processType, projectPath) }
			hx-target="#ftl-output"
			hx-swap="beforeend"
			hx-on::before-request="this.disabled=true; this.textContent='Stopping...'"
			class={ ui.CSSClasses.Buttons["action_small"] }
			style={ fmt.Sprintf("background-color: %s;", ui.Colors.Accents["red"]) }>
			Stop
		</button>
	}
}

// UniversalStatusDot - Single status component that can be used everywhere
// Parameters:
//   - isRunning: true if any process is running
//   - processType: "regular", "watch", or "" if not running
//   - size: "sm" (sidebar) or "md" (main content) 
//   - showLabel: whether to show status text
templ UniversalStatusDot(isRunning bool, processType string, size string, showLabel bool) {
	<div class="flex items-center">
		// Status dot with appropriate color
		if isRunning {
			if processType == "watch" {
				<span class={ ui.CSSClasses.Components["status_dot"] + " " + ui.CSSClasses.StatusDots["watching"] } aria-label="Process watching"></span>
			} else {
				<span class={ ui.CSSClasses.Components["status_dot"] + " " + ui.CSSClasses.StatusDots["running"] } aria-label="Process running"></span>
			}
		} else {
			<span class={ ui.CSSClasses.Components["status_dot"] + " " + ui.CSSClasses.StatusDots["stopped"] } aria-label="Process stopped"></span>
		}
		
		// Optional status label
		if showLabel {
			if isRunning {
				if processType == "watch" {
					<span class="text-xs font-mono ml-2" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["primary_text"]) }>
						{ ui.StatusWatching }
					</span>
				} else {
					<span class="text-xs font-mono ml-2" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["primary_text"]) }>
						{ ui.StatusRunning }
					</span>
				}
			} else {
				<span class="text-xs font-mono ml-2" style={ fmt.Sprintf("color: %s;", ui.Colors.UI["primary_text"]) }>
					{ ui.StatusStopped }
				</span>
			}
		}
	</div>
}