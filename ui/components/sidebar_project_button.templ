package components

import (
	"fmt"
	"time"
	ui "github.com/fastertools/ftl/ui/gen"
)

// Project represents a project in the sidebar (avoiding import cycle with templates package)
type Project struct {
	Name         string
	Path         string
	Status       string
	LastUpdated  time.Time
	FTLRunning   bool
	WatchRunning bool
}

// SidebarProjectButtonConfig defines the configuration for a SidebarProjectButton component
type SidebarProjectButtonConfig struct {
	Project         Project  // Project data including Name, Path, FTLRunning, WatchRunning
	IsActive        bool     // Whether this project is currently active/selected
	Disabled        bool     // Whether button interactions are disabled
	ExtraClasses    string   // Additional CSS classes
	HTMX            *SidebarProjectButtonHTMXConfig // HTMX configuration (optional)
}

// SidebarProjectButtonHTMXConfig defines HTMX attributes for SidebarProjectButton
type SidebarProjectButtonHTMXConfig struct {
	SwitchPost   string // hx-post endpoint for project switching
	RemoveDelete string // hx-delete endpoint for project removal
	Target       string // hx-target selector
	Swap         string // hx-swap strategy
	Confirm      string // hx-confirm message for removal
}

// Unified hover behavior script functions (matching BaseButton)
script handleSidebarProjectButtonHover(event templ.JSExpression, bgColor, borderColor string) {
	event.target.style.backgroundColor = bgColor;
	event.target.style.borderColor = borderColor;
	event.target.style.transform = 'translateY(-1px)';
}

script handleSidebarProjectButtonOut(event templ.JSExpression, bgColor, borderColor string) {
	event.target.style.backgroundColor = bgColor;
	event.target.style.borderColor = borderColor;
	event.target.style.transform = 'translateY(0)';
}

// SidebarProjectButton provides a unified project button component with consistent hover behavior and HTMX integration
templ SidebarProjectButton(config SidebarProjectButtonConfig) {
	<div 
		class={ getSidebarProjectButtonClasses(config.IsActive, config.ExtraClasses) }
		data-project-name={ config.Project.Name }
		data-project-path={ config.Project.Path }
		style={ getSidebarProjectButtonStyles(config.IsActive) }
		if !config.IsActive && !config.Disabled {
			onmouseover={ handleSidebarProjectButtonHover(templ.JSExpression("event"), ui.Colors.UI["button_bg_hover"], ui.Colors.UI["border_hover"]) }
			onmouseout={ handleSidebarProjectButtonOut(templ.JSExpression("event"), ui.Colors.UI["button_bg"], ui.Colors.UI["button_border"]) }
		}
		role="listitem"
	>
		<div class={ ui.CSSClasses.Components["flex_space_between"] }>
			if config.IsActive {
				<!-- Active project display (non-clickable) -->
				<div class={ ui.CSSClasses.Components["flex_items_center"] }>
					@getProjectStatusDot(config.Project)
					<span class={ ui.CSSClasses.Components["project_name"] + " ml-2" } 
						style={ fmt.Sprintf("color: %s;", ui.Colors.Primary.Text) }>
						{ config.Project.Name }
					</span>
				</div>
			} else {
				<!-- Inactive project button (clickable) -->
				<button 
					if config.HTMX != nil && config.HTMX.SwitchPost != "" {
						hx-post={ config.HTMX.SwitchPost }
					} else {
						hx-post={ "/htmx/project/switch?path=" + config.Project.Path }
					}
					if config.HTMX != nil && config.HTMX.Target != "" {
						hx-target={ config.HTMX.Target }
					} else {
						hx-target="#main-container"
					}
					if config.HTMX != nil && config.HTMX.Swap != "" {
						hx-swap={ config.HTMX.Swap }
					} else {
						hx-swap="innerHTML"
					}
					class="flex-1 text-left flex items-center cursor-pointer"
					aria-label={ fmt.Sprintf("Switch to project %s", config.Project.Name) }
					if config.Disabled {
						disabled
					}
				>
					@getProjectStatusDot(config.Project)
					<span class={ ui.CSSClasses.Components["project_name"] + " ml-2" } 
						style={ fmt.Sprintf("color: %s;", ui.Colors.UI["muted_text"]) }>
						{ config.Project.Name }
					</span>
				</button>
			}
			
			<!-- Remove button (always present) -->
			<button 
				if config.HTMX != nil && config.HTMX.RemoveDelete != "" {
					hx-delete={ config.HTMX.RemoveDelete }
				} else {
					hx-delete={ "/htmx/project/remove?path=" + config.Project.Path }
				}
				if config.HTMX != nil && config.HTMX.Target != "" {
					hx-target={ config.HTMX.Target }
				} else {
					hx-target="#project-list"
				}
				if config.HTMX != nil && config.HTMX.Swap != "" {
					hx-swap={ config.HTMX.Swap }
				} else {
					hx-swap="innerHTML"
				}
				if config.HTMX != nil && config.HTMX.Confirm != "" {
					hx-confirm={ config.HTMX.Confirm }
				} else {
					hx-confirm="Remove this project?"
				}
				class={ getRemoveButtonClasses(config.IsActive) }
				aria-label={ fmt.Sprintf("Remove project %s", config.Project.Name) }
				if config.Disabled {
					disabled
				}
			>
				×
			</button>
		</div>
	</div>
}

// Helper component to render project status dot based on project state
templ getProjectStatusDot(project Project) {
	<div class={ getStatusDotClasses(project) } style={ getStatusDotStyles(project) }></div>
}

// Helper function to get status dot CSS classes
func getStatusDotClasses(project Project) string {
	baseClass := ui.CSSClasses.Components["status_dot"]
	
	if project.WatchRunning {
		return fmt.Sprintf("%s %s", baseClass, ui.CSSClasses.StatusDots["watching"])
	} else if project.FTLRunning {
		return fmt.Sprintf("%s %s", baseClass, ui.CSSClasses.StatusDots["running"])
	} else {
		return fmt.Sprintf("%s %s", baseClass, ui.CSSClasses.StatusDots["stopped"])
	}
}

// Helper function to get status dot styles
func getStatusDotStyles(project Project) string {
	if project.WatchRunning {
		return fmt.Sprintf("background-color: %s;", ui.Colors.Status["watching"])
	} else if project.FTLRunning {
		return fmt.Sprintf("background-color: %s;", ui.Colors.Status["running"])
	} else {
		return fmt.Sprintf("background-color: %s;", ui.Colors.Status["stopped"])
	}
}

// Helper functions for SidebarProjectButton

// getSidebarProjectButtonClasses returns the CSS classes for the project button container
func getSidebarProjectButtonClasses(isActive bool, extraClasses string) string {
	baseClass := "project-item px-3 py-2 text-sm rounded-md"
	
	var stateClass string
	if isActive {
		stateClass = "project-item-active"
	} else {
		stateClass = "project-item-inactive transition-all duration-200 cursor-pointer"
	}
	
	classes := fmt.Sprintf("%s %s", baseClass, stateClass)
	
	if extraClasses != "" {
		classes = fmt.Sprintf("%s %s", classes, extraClasses)
	}
	
	return classes
}

// getSidebarProjectButtonStyles returns the inline styles for the project button
func getSidebarProjectButtonStyles(isActive bool) string {
	if isActive {
		return fmt.Sprintf(
			"background-color: %s; border-left: 5px solid %s;",
			ui.Colors.UI["button_bg_hover"],
			ui.Colors.Accents["blue"],
		)
	} else {
		return fmt.Sprintf(
			"background-color: %s; border: 1px solid %s; transition: all 200ms ease;",
			ui.Colors.UI["button_bg"],
			ui.Colors.UI["button_border"],
		)
	}
}

// getRemoveButtonClasses returns the CSS classes for the remove button
func getRemoveButtonClasses(isActive bool) string {
	baseClass := "text-red-400 hover:text-red-300 text-xs"
	if !isActive {
		return fmt.Sprintf("%s ml-2", baseClass)
	}
	return baseClass
}