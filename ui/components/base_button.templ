package components

import (
	"fmt"
	ui "github.com/fastertools/ftl/ui/gen"
)

// BaseButtonConfig defines the configuration for a BaseButton component
type BaseButtonConfig struct {
	Type         string                 // button type: "submit", "button" (default: "button")
	Content      string                 // button text content
	Disabled     bool                   // whether button is disabled
	ExtraClasses string                 // additional CSS classes
	HTMX         *BaseButtonHTMXConfig  // HTMX configuration (optional)
}

// BaseButtonHTMXConfig defines HTMX attributes for BaseButton
type BaseButtonHTMXConfig struct {
	Post     string // hx-post endpoint
	Target   string // hx-target selector
	Swap     string // hx-swap strategy
	Trigger  string // hx-trigger events
	Vals     string // hx-vals JSON data
	Include  string // hx-include selector
}

// Unified hover behavior script functions
script handleBaseButtonHover(event templ.JSExpression, bgColor, borderColor string) {
	event.target.style.backgroundColor = bgColor;
	event.target.style.borderColor = borderColor;
	event.target.style.transform = 'translateY(-1px)';
}

script handleBaseButtonOut(event templ.JSExpression, bgColor, borderColor string) {
	event.target.style.backgroundColor = bgColor;
	event.target.style.borderColor = borderColor;
	event.target.style.transform = 'translateY(0)';
}

// BaseButton provides a unified button component with consistent hover behavior and HTMX integration
templ BaseButton(config BaseButtonConfig) {
	<button
		type={ getButtonType(config.Type) }
		class={ getButtonClasses(config.ExtraClasses) }
		style={ getButtonStyles() }
		if !config.Disabled {
			onmouseover={ handleBaseButtonHover(templ.JSExpression("event"), ui.Colors.UI["button_bg_hover"], ui.Colors.UI["border_hover"]) }
			onmouseout={ handleBaseButtonOut(templ.JSExpression("event"), ui.Colors.UI["button_bg"], ui.Colors.UI["button_border"]) }
		}
		if config.Disabled {
			disabled
		}
		if config.HTMX != nil {
			if config.HTMX.Post != "" {
				hx-post={ config.HTMX.Post }
			}
			if config.HTMX.Target != "" {
				hx-target={ config.HTMX.Target }
			}
			if config.HTMX.Swap != "" {
				hx-swap={ config.HTMX.Swap }
			}
			if config.HTMX.Trigger != "" {
				hx-trigger={ config.HTMX.Trigger }
			}
			if config.HTMX.Vals != "" {
				hx-vals={ config.HTMX.Vals }
			}
			if config.HTMX.Include != "" {
				hx-include={ config.HTMX.Include }
			}
		}
		role="button"
		aria-label={ config.Content }
	>
		{ config.Content }
	</button>
}

// Helper functions for BaseButton

// getButtonType returns the appropriate button type
func getButtonType(configType string) string {
	if configType == "submit" {
		return "submit"
	}
	return "button"
}

// getButtonClasses returns the CSS classes for the button
func getButtonClasses(extraClasses string) string {
	baseClass := ui.CSSClasses.Buttons["ftl_control"]
	if extraClasses != "" {
		return fmt.Sprintf("%s %s", baseClass, extraClasses)
	}
	return baseClass
}

// getButtonStyles returns the inline styles for the button
func getButtonStyles() string {
	return fmt.Sprintf(
		"background-color: %s; border: 1px solid %s; transition: all %s ease;",
		ui.Colors.UI["button_bg"],
		ui.Colors.UI["button_border"],
		"200ms", // ui.Timing.HoverDuration when available
	)
}